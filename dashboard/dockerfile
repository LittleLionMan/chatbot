FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.29.0 \
    asyncpg>=0.29.0 \
    python-dotenv>=1.0.1 \
    pydantic>=2.0.0 \
    aiofiles>=23.0.0

COPY main.py .
COPY index.html .
COPY utils.js .
COPY agents/ agents/
COPY memory.js .
COPY scrapers.js .
COPY monitors.js .
COPY usage.js .
COPY registry.js .
COPY triggers.js .
COPY app.js .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
